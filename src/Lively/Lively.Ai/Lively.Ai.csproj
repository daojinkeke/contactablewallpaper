<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.18362.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Lively.Ai</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lively.Models\Lively.Models.csproj" />
    <ProjectReference Include="..\Lively.Common\Lively.Common.csproj" />
    <!-- 深度视差：直接复用基线 Lively.ML 的 MiDaS + ONNX Runtime 实现，不另写推理代码。 -->
    <ProjectReference Include="..\Lively.ML\Lively.ML.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\spacewallpaper.html" LogicalName="Lively.Ai.Templates.spacewallpaper.html" />
    <!-- 去视觉的交互骨架，按交互能力条件注入 user prompt，结构示例不参与校验。 -->
    <EmbeddedResource Include="References\interaction-scaffold.js.txt" LogicalName="Lively.Ai.References.interaction-scaffold.js.txt" />
  </ItemGroup>

</Project>
