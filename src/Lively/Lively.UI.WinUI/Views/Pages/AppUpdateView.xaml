<Page
    x:Class="Lively.UI.WinUI.Views.Pages.AppUpdateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="450"
    mc:Ignorable="d">

    <Grid Padding="24">
        <StackPanel
            MaxWidth="620"
            HorizontalAlignment="Left"
            Spacing="14">
            <TextBlock
                CharacterSpacing="180"
                FontSize="10"
                Foreground="{ThemeResource ContactableAccentBrush}"
                Text="APPLICATION UPDATE" />
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Text="应用更新" />
            <TextBlock
                FontSize="16"
                Text="当前为最新版本。" />
            <Border
                Padding="16"
                Background="{ThemeResource ContactableSurfaceBrush}"
                BorderBrush="{ThemeResource ContactableHairlineBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Name="VersionText"
                        FontWeight="SemiBold" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="本产品的更新由 Contactable 自有通道提供，此页面不会打开或跳转任何外部站点。"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="需要获取新版本时，请通过你获取本产品的渠道获取安装包。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
