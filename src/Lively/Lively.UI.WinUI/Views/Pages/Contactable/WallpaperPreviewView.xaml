<Page
    x:Class="Lively.UI.WinUI.Views.Pages.Contactable.WallpaperPreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <!--  远景：星尘与吸积光晕，纯装饰  -->
        <Grid IsHitTestVisible="False">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#140B1E3F" />
                    <GradientStop Offset="0.5" Color="#00000000" />
                    <GradientStop Offset="1" Color="#14F59E0B" />
                </LinearGradientBrush>
            </Grid.Background>
            <Ellipse
                Width="600"
                Height="360"
                Margin="-190,-190,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#3A6EA8FE" />
                        <GradientStop Offset="1" Color="#006EA8FE" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse
                Width="480"
                Height="320"
                Margin="0,0,-160,-160"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#2EF59E0B" />
                        <GradientStop Offset="1" Color="#00F59E0B" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Path
                Fill="#59D6E4FF"
                Stretch="Fill"
                Data="M86,68 A2,2 0 1 1 90,68 A2,2 0 1 1 86,68 Z M216,136 A2,2 0 1 1 220,136 A2,2 0 1 1 216,136 Z M346,60 A2,2 0 1 1 350,60 A2,2 0 1 1 346,60 Z M476,172 A2,2 0 1 1 480,172 A2,2 0 1 1 476,172 Z M606,90 A2,2 0 1 1 610,90 A2,2 0 1 1 606,90 Z M736,150 A2,2 0 1 1 740,150 A2,2 0 1 1 736,150 Z M866,70 A2,2 0 1 1 870,70 A2,2 0 1 1 866,70 Z M946,208 A2,2 0 1 1 950,208 A2,2 0 1 1 946,208 Z M126,296 A2,2 0 1 1 130,296 A2,2 0 1 1 126,296 Z M266,376 A2,2 0 1 1 270,376 A2,2 0 1 1 266,376 Z M406,296 A2,2 0 1 1 410,296 A2,2 0 1 1 406,296 Z M536,416 A2,2 0 1 1 540,416 A2,2 0 1 1 536,416 Z M676,336 A2,2 0 1 1 680,336 A2,2 0 1 1 676,336 Z M816,436 A2,2 0 1 1 820,436 A2,2 0 1 1 816,436 Z M916,356 A2,2 0 1 1 920,356 A2,2 0 1 1 916,356 Z M66,516 A2,2 0 1 1 70,516 A2,2 0 1 1 66,516 Z M196,606 A2,2 0 1 1 200,606 A2,2 0 1 1 196,606 Z M346,536 A2,2 0 1 1 350,536 A2,2 0 1 1 346,536 Z M496,636 A2,2 0 1 1 500,636 A2,2 0 1 1 496,636 Z M636,556 A2,2 0 1 1 640,556 A2,2 0 1 1 636,556 Z M776,646 A2,2 0 1 1 780,646 A2,2 0 1 1 776,646 Z M906,556 A2,2 0 1 1 910,556 A2,2 0 1 1 906,556 Z" />
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Margin="28,18,28,10"
                Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon
                        Width="22"
                        Height="22"
                        Foreground="{ThemeResource ContactableAccentBrush}"
                        Data="F1 M2 12 A10 10 0 1 1 22 12 A10 10 0 1 1 2 12 Z M5.4 12 A6.6 6.6 0 1 0 18.6 12 A6.6 6.6 0 1 0 5.4 12 Z" />
                    <TextBlock
                        VerticalAlignment="Center"
                        CharacterSpacing="120"
                        FontSize="11"
                        Foreground="{ThemeResource ContactableAccentBrush}"
                        Text="SHELL 03 · PREVIEW" />
                </StackPanel>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock FontSize="30" FontWeight="SemiBold" Text="预览" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="查看当前显示器上的壁纸，并从壁纸库换一张。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Padding="12,8"
                        VerticalAlignment="Center"
                        Background="#146EA8FE"
                        BorderBrush="{ThemeResource ContactableHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                CharacterSpacing="140"
                                FontSize="10"
                                Foreground="{ThemeResource ContactableAccentBrush}"
                                Text="LIVE SURFACE" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="WebView2 实时渲染" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel
                    MaxWidth="980"
                    Margin="28,0,28,24"
                    HorizontalAlignment="Left"
                    Spacing="16">

                    <Border
                        Padding="18"
                        BorderBrush="{ThemeResource ContactableHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                                <GradientStop Offset="0" Color="#1FA0C4FF" />
                                <GradientStop Offset="1" Color="#0890B4FF" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="4"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ContactableAccentBrush}"
                                    CornerRadius="2" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="显示器" />
                                    <TextBlock
                                        CharacterSpacing="100"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="01 · DISPLAY" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="MonitorCombo"
                                    DisplayMemberPath="Label"
                                    SelectionChanged="MonitorCombo_SelectionChanged" />
                                <Button
                                    Grid.Column="1"
                                    Click="RefreshButton_Click"
                                    Content="刷新" />
                            </Grid>
                            <TextBlock
                                x:Name="MonitorInfoText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="18"
                        BorderBrush="{ThemeResource ContactableHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                                <GradientStop Offset="0" Color="#24A0C4FF" />
                                <GradientStop Offset="1" Color="#0890B4FF" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="4"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Background="#FF34D399"
                                    CornerRadius="2" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock
                                        x:Name="PreviewSectionTitle"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="当前壁纸" />
                                    <TextBlock
                                        CharacterSpacing="100"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="02 · NOW PLAYING" />
                                </StackPanel>
                            </Grid>
                            <Grid Height="320" MinHeight="320">
                                <Border
                                    Background="{ThemeResource ContactableChipBrush}"
                                    BorderBrush="{ThemeResource ContactableHairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12" />
                                <Image
                                    x:Name="CurrentImage"
                                    Height="320"
                                    Stretch="UniformToFill" />
                                <WebView2
                                    x:Name="PreviewWebView"
                                    Height="320"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    DefaultBackgroundColor="Transparent"
                                    Visibility="Collapsed" />
                                <StackPanel
                                    x:Name="NoWallpaperPanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8"
                                    Visibility="Visible">
                                    <Grid
                                        Width="150"
                                        Height="96"
                                        HorizontalAlignment="Center">
                                        <Ellipse
                                            Width="126"
                                            Height="34"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Stroke="#FFF59E0B"
                                            StrokeThickness="2"
                                            Opacity="0.55">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform Angle="-14" CenterX="63" CenterY="17" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse
                                            Width="58"
                                            Height="58"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush>
                                                    <GradientStop Offset="0" Color="#FF080D1A" />
                                                    <GradientStop Offset="0.72" Color="#FF12203B" />
                                                    <GradientStop Offset="1" Color="#FF1E3457" />
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse
                                            Width="72"
                                            Height="72"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Stroke="#596EA8FE"
                                            StrokeThickness="1" />
                                    </Grid>
                                    <TextBlock
                                        x:Name="NoWallpaperTitle"
                                        HorizontalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="正在读取当前壁纸" />
                                    <TextBlock
                                        x:Name="NoWallpaperDescription"
                                        MaxWidth="420"
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="如果长时间停留在这一屏，请点右上角“刷新”，或检查 Core 是否已启动。"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel
                                    x:Name="PreviewPlaceholder"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="6"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="PreviewPlaceholderTitle"
                                        HorizontalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="网页预览暂不可用" />
                                    <TextBlock
                                        x:Name="PreviewPlaceholderText"
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="已显示壁纸缩略图。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ProgressRing
                                    x:Name="LoadingRing"
                                    Width="36"
                                    Height="36"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsActive="False"
                                    Visibility="Collapsed" />
                            </Grid>
                            <StackPanel x:Name="CurrentInfoPanel" Spacing="4">
                                <TextBlock
                                    x:Name="CurrentTitle"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="未应用壁纸" />
                                <TextBlock
                                    x:Name="CurrentType"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="CurrentPath"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="PreviewModeHint"
                                    FontSize="12"
                                    Foreground="{ThemeResource ContactableAccentBrush}"
                                    Text="预览中 · 尚未应用到桌面，点下方“更换”才会生效。"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="18"
                        BorderBrush="{ThemeResource ContactableHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                                <GradientStop Offset="0" Color="#1FA0C4FF" />
                                <GradientStop Offset="1" Color="#0890B4FF" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="4"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ContactableAccentBrush}"
                                    CornerRadius="2" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="更换壁纸" />
                                    <TextBlock
                                        CharacterSpacing="100"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="03 · SWITCH" />
                                </StackPanel>
                            </Grid>
                            <ComboBox
                                x:Name="WallpaperPicker"
                                DisplayMemberPath="Title"
                                PlaceholderText="从壁纸库选择"
                                SelectionChanged="WallpaperPicker_SelectionChanged" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button
                                    x:Name="SwitchButton"
                                    Click="SwitchButton_Click"
                                    Content="更换"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    Click="OpenLibraryButton_Click"
                                    Content="打开壁纸库" />
                                <ProgressRing
                                    x:Name="SwitchRing"
                                    Width="20"
                                    Height="20"
                                    IsActive="False"
                                    Visibility="Collapsed" />
                            </StackPanel>
                            <ProgressBar
                                x:Name="SwitchProgress"
                                Height="4"
                                CornerRadius="2"
                                IsIndeterminate="True"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <InfoBar
                x:Name="StatusBar"
                Grid.Row="2"
                Margin="28,8,28,16"
                IsClosable="True"
                IsOpen="False" />
        </Grid>
    </Grid>
</Page>
