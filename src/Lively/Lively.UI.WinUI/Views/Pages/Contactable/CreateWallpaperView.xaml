<Page
    x:Class="Lively.UI.WinUI.Views.Pages.Contactable.CreateWallpaperView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <!--  远景：星尘与吸积光晕，纯装饰  -->
        <Grid IsHitTestVisible="False">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#140B1E3F" />
                    <GradientStop Offset="0.5" Color="#00000000" />
                    <GradientStop Offset="1" Color="#14F59E0B" />
                </LinearGradientBrush>
            </Grid.Background>
            <Ellipse
                Width="620"
                Height="380"
                Margin="-200,-200,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#3A6EA8FE" />
                        <GradientStop Offset="1" Color="#006EA8FE" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse
                Width="520"
                Height="340"
                Margin="0,0,-180,-180"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#2EF59E0B" />
                        <GradientStop Offset="1" Color="#00F59E0B" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Path
                Fill="#59D6E4FF"
                Stretch="Fill"
                Data="M66,60 A2,2 0 1 1 70,60 A2,2 0 1 1 66,60 Z M186,120 A2,2 0 1 1 190,120 A2,2 0 1 1 186,120 Z M316,48 A2,2 0 1 1 320,48 A2,2 0 1 1 316,48 Z M446,158 A2,2 0 1 1 450,158 A2,2 0 1 1 446,158 Z M576,78 A2,2 0 1 1 580,78 A2,2 0 1 1 576,78 Z M706,138 A2,2 0 1 1 710,138 A2,2 0 1 1 706,138 Z M836,58 A2,2 0 1 1 840,58 A2,2 0 1 1 836,58 Z M956,188 A2,2 0 1 1 960,188 A2,2 0 1 1 956,188 Z M106,278 A2,2 0 1 1 110,278 A2,2 0 1 1 106,278 Z M246,358 A2,2 0 1 1 250,358 A2,2 0 1 1 246,358 Z M386,278 A2,2 0 1 1 390,278 A2,2 0 1 1 386,278 Z M516,398 A2,2 0 1 1 520,398 A2,2 0 1 1 516,398 Z M656,318 A2,2 0 1 1 660,318 A2,2 0 1 1 656,318 Z M796,418 A2,2 0 1 1 800,418 A2,2 0 1 1 796,418 Z M916,338 A2,2 0 1 1 920,338 A2,2 0 1 1 916,338 Z M46,498 A2,2 0 1 1 50,498 A2,2 0 1 1 46,498 Z M176,588 A2,2 0 1 1 180,588 A2,2 0 1 1 176,588 Z M326,518 A2,2 0 1 1 330,518 A2,2 0 1 1 326,518 Z M476,618 A2,2 0 1 1 480,618 A2,2 0 1 1 476,618 Z M616,538 A2,2 0 1 1 620,538 A2,2 0 1 1 616,538 Z M756,628 A2,2 0 1 1 760,628 A2,2 0 1 1 756,628 Z M886,538 A2,2 0 1 1 890,538 A2,2 0 1 1 886,538 Z" />
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="1040"
                Margin="28,18,28,40"
                HorizontalAlignment="Left"
                Spacing="16">

                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon
                                Width="22"
                                Height="22"
                                Foreground="{ThemeResource ContactableAccentBrush}"
                                Data="F1 M2 12 A10 10 0 1 1 22 12 A10 10 0 1 1 2 12 Z M5.4 12 A6.6 6.6 0 1 0 18.6 12 A6.6 6.6 0 1 0 5.4 12 Z" />
                            <TextBlock
                                VerticalAlignment="Center"
                                CharacterSpacing="120"
                                FontSize="11"
                                Foreground="{ThemeResource ContactableAccentBrush}"
                                Text="SHELL 01 · CREATE" />
                        </StackPanel>
                        <TextBlock FontSize="30" FontWeight="SemiBold" Text="新建壁纸" />
                        <TextBlock
                            MaxWidth="620"
                            HorizontalAlignment="Left"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="描述你想要的画面，选择风格与配色，生成一张可交互的网页壁纸。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Padding="14,10"
                        VerticalAlignment="Center"
                        Background="#146EA8FE"
                        BorderBrush="{ThemeResource ContactableHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="3">
                            <TextBlock
                                CharacterSpacing="140"
                                FontSize="10"
                                Foreground="{ThemeResource ContactableAccentBrush}"
                                Text="GENERATION CORE" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="远程 HTML · 本地深度" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border
                    Height="2"
                    Margin="0,-4,0,0"
                    CornerRadius="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#CC6EA8FE" />
                            <GradientStop Offset="0.55" Color="#33F59E0B" />
                            <GradientStop Offset="1" Color="#00F59E0B" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border
                    Padding="18"
                    BorderBrush="{ThemeResource ContactableHairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                            <GradientStop Offset="0" Color="#1FA0C4FF" />
                            <GradientStop Offset="1" Color="#0890B4FF" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="4"
                                Height="20"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ContactableAccentBrush}"
                                CornerRadius="2" />
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="风格预设" />
                                <TextBlock
                                    CharacterSpacing="100"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="01 · STYLE" />
                            </StackPanel>
                            <TextBlock
                                x:Name="SelectedStyleText"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource ContactableAccentBrush}" />
                        </Grid>
                        <GridView
                            x:Name="StyleGrid"
                            IsItemClickEnabled="False"
                            SelectionMode="None">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid MaximumRowsOrColumns="5" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Width="176"
                                        Height="132"
                                        Margin="0,0,10,10"
                                        Padding="0"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="StyleCard_Click"
                                        Tag="{Binding Key}">
                                        <Border
                                            Padding="12"
                                            Background="#1490B4FF"
                                            BorderBrush="{ThemeResource ContactableHairlineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                            <StackPanel Spacing="8">
                                                <Border
                                                    Height="42"
                                                    Background="{Binding PreviewBrush}"
                                                    CornerRadius="8" />
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    MaxLines="2"
                                                    Text="{Binding Description}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="配色" />
                        <StackPanel
                            x:Name="ColorPanel"
                            Orientation="Horizontal"
                            Spacing="8" />
                    </StackPanel>
                </Border>

                <Border
                    Padding="18"
                    BorderBrush="{ThemeResource ContactableHairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                            <GradientStop Offset="0" Color="#1FA0C4FF" />
                            <GradientStop Offset="1" Color="#0890B4FF" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="4"
                                Height="20"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ContactableAccentBrush}"
                                CornerRadius="2" />
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="描述" />
                                <TextBlock
                                    CharacterSpacing="100"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="02 · PROMPT" />
                            </StackPanel>
                        </Grid>
                        <TextBox
                            x:Name="PromptBox"
                            Height="118"
                            AcceptsReturn="True"
                            MaxLength="2000"
                            PlaceholderText="例如：深空里的黑洞，吸积盘缓慢旋转，粒子能被鼠标吸引"
                            TextChanged="PromptBox_TextChanged"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="PromptCounter"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="0 / 2000" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="试试这些" />
                        <StackPanel
                            x:Name="ExamplePanel"
                            Orientation="Horizontal"
                            Spacing="8" />
                    </StackPanel>
                </Border>

                <Border
                    Padding="18"
                    Background="#1A6EA8FE"
                    BorderBrush="{ThemeResource ContactableAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="4"
                                Height="20"
                                VerticalAlignment="Center"
                                Background="#FFF59E0B"
                                CornerRadius="2" />
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="生成" />
                                <TextBlock
                                    CharacterSpacing="100"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="03 · GENERATE" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="GenerateStatus" Text="准备就绪" />
                                <ProgressBar
                                    x:Name="GenerateProgress"
                                    Height="6"
                                    Maximum="100"
                                    CornerRadius="3"
                                    Value="0" />
                            </StackPanel>
                            <Button
                                x:Name="GenerateButton"
                                Grid.Column="1"
                                MinWidth="128"
                                VerticalAlignment="Center"
                                Click="GenerateButton_Click"
                                Content="开始生成"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                x:Name="CancelButton"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="CancelButton_Click"
                                Content="取消"
                                Visibility="Collapsed" />
                            <ProgressRing
                                x:Name="GenerateRing"
                                Grid.Column="3"
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                IsActive="False"
                                Visibility="Collapsed" />
                        </Grid>
                        <Border
                            Padding="12"
                            Background="#1490B4FF"
                            BorderBrush="{ThemeResource ContactableHairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="节能模式" />
                                        <Border
                                            Padding="8,1"
                                            VerticalAlignment="Center"
                                            Background="#1A6EA8FE"
                                            CornerRadius="8">
                                            <TextBlock
                                                x:Name="EcoStateText"
                                                CharacterSpacing="60"
                                                FontSize="10"
                                                Foreground="{ThemeResource ContactableAccentBrush}"
                                                Text="已关闭" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="空闲时自动降帧、简化动效，省电降温；有鼠标交互时恢复正常。开启后本次生成与对话续改都会带上 --eco。"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="EcoSessionHint"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="当前续接的会话使用节能模式，继续修改会沿用该设置。"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="EcoToggle"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="节能模式开关"
                                    Toggled="EcoToggle_Toggled" />
                            </Grid>
                        </Border>
                        <Border
                            Padding="12"
                            Background="#1490B4FF"
                            BorderBrush="{ThemeResource ContactableHairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="InlineAiStatus"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="AI 服务：未配置" />
                                    <Button
                                        x:Name="InlineAiToggleButton"
                                        Grid.Column="1"
                                        Click="InlineAiToggleButton_Click"
                                        Content="配置 AI" />
                                </Grid>
                                <StackPanel
                                    x:Name="InlineAiPanel"
                                    Spacing="8"
                                    Visibility="Collapsed">
                                    <TextBox
                                        x:Name="InlineBaseUrlBox"
                                        Header="BaseUrl"
                                        PlaceholderText="例如 https://api.openai.com/v1" />
                                    <TextBox
                                        x:Name="InlineModelBox"
                                        Header="模型"
                                        PlaceholderText="例如 gpt-4o-mini" />
                                    <PasswordBox
                                        x:Name="InlineApiKeyBox"
                                        Header="API Key"
                                        PasswordRevealMode="Peek"
                                        PlaceholderText="留空则沿用已保存的 Key" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="InlineAiKeyState"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="未配置" />
                                        <Button
                                            x:Name="InlineAiSaveButton"
                                            Grid.Column="1"
                                            Click="InlineAiSaveButton_Click"
                                            Content="保存配置"
                                            Style="{StaticResource AccentButtonStyle}" />
                                        <Button
                                            x:Name="InlineAiClearButton"
                                            Grid.Column="2"
                                            Click="InlineAiClearButton_Click"
                                            Content="清除 Key" />
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="额度方式" />
                                        <ComboBox
                                            x:Name="InlineUsageModeCombo"
                                            Grid.Column="1"
                                            IsEnabled="False"
                                            SelectedIndex="0">
                                            <ComboBoxItem Content="自己的 API Key" />
                                            <ComboBoxItem Content="服务方额度（即将支持）" />
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="与设置页共用同一份 AiSettings.json；保存后下一次生成立即生效。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <InfoBar
                            x:Name="ErrorBar"
                            IsClosable="True"
                            IsOpen="False"
                            Severity="Error">
                            <InfoBar.ActionButton>
                                <Button
                                    x:Name="GoSettingsButton"
                                    Click="GoSettingsButton_Click"
                                    Content="就地配置"
                                    Visibility="Collapsed" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="ResultCard"
                    Padding="18"
                    BorderBrush="{ThemeResource ContactableHairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                            <GradientStop Offset="0" Color="#24A0C4FF" />
                            <GradientStop Offset="1" Color="#0890B4FF" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="4"
                                Height="20"
                                VerticalAlignment="Center"
                                Background="#FF34D399"
                                CornerRadius="2" />
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="生成结果" />
                                <TextBlock
                                    CharacterSpacing="100"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="RESULT · 可预览、入库或立即应用" />
                            </StackPanel>
                        </Grid>
                        <Grid Height="300">
                            <Border Background="{ThemeResource ContactableChipBrush}" CornerRadius="12" />
                            <Image
                                x:Name="ResultImage"
                                Height="300"
                                Stretch="UniformToFill" />
                            <WebView2
                                x:Name="ResultWebView"
                                Height="300"
                                Visibility="Collapsed" />
                        </Grid>
                        <TextBlock
                            x:Name="ResultTitle"
                            FontSize="18"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="ResultPath"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                x:Name="ApplyButton"
                                Click="ApplyButton_Click"
                                Content="立即应用"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                x:Name="SaveToLibraryButton"
                                Click="SaveToLibraryButton_Click"
                                Content="保存到壁纸库" />
                            <ProgressRing
                                x:Name="SaveRing"
                                Width="20"
                                Height="20"
                                IsActive="False"
                                Visibility="Collapsed" />
                        </StackPanel>
                        <ProgressBar
                            x:Name="SaveProgress"
                            Height="4"
                            CornerRadius="2"
                            IsIndeterminate="True"
                            Visibility="Collapsed" />

                        <Border
                            x:Name="ConversationPanel"
                            Padding="14"
                            Background="#1490B4FF"
                            BorderBrush="{ThemeResource ContactableHairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="Collapsed">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Text="对话续改" />
                                        <Border
                                            Padding="8,1"
                                            VerticalAlignment="Center"
                                            Background="#1A6EA8FE"
                                            CornerRadius="8">
                                            <TextBlock
                                                x:Name="ConversationSessionText"
                                                CharacterSpacing="60"
                                                FontSize="10"
                                                Foreground="{ThemeResource ContactableAccentBrush}"
                                                Text="无会话" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="ConversationVersionText"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>

                                <TextBlock
                                    x:Name="LegacyConversationHint"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="这条记录来自旧版生成器，没有可续接的会话。重新生成一张后即可对话续改。"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />

                                <StackPanel
                                    x:Name="ConversationBody"
                                    Spacing="10">
                                    <StackPanel Spacing="6">
                                        <TextBlock
                                            CharacterSpacing="100"
                                            FontSize="10"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="版本走廊 · 点击切换预览" />
                                        <StackPanel
                                            x:Name="VersionRail"
                                            Orientation="Horizontal"
                                            Spacing="6" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                x:Name="ApplyVersionButton"
                                                Click="ApplyVersionButton_Click"
                                                Content="应用此版本"
                                                Style="{StaticResource AccentButtonStyle}" />
                                            <Button
                                                x:Name="SaveVersionButton"
                                                Click="SaveVersionButton_Click"
                                                Content="保存此版本到壁纸库" />
                                        </StackPanel>
                                    </StackPanel>

                                    <ScrollViewer
                                        x:Name="DialogueScroller"
                                        MaxHeight="210"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="DialogueList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Margin="0,0,0,6"
                                                        Padding="10,8"
                                                        Background="#1290B4FF"
                                                        BorderBrush="{ThemeResource ContactableHairlineBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock
                                                                CharacterSpacing="60"
                                                                FontSize="10"
                                                                Foreground="{ThemeResource ContactableAccentBrush}"
                                                                Text="{Binding Caption}" />
                                                            <TextBlock
                                                                FontSize="12"
                                                                Text="{Binding Body}"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <TextBox
                                        x:Name="ReviseBox"
                                        Header="继续修改"
                                        PlaceholderText="例如：把吸积盘调暖一点，粒子移动更慢"
                                        MaxLength="500" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="ReviseButton"
                                            Click="ReviseButton_Click"
                                            Content="提交修改"
                                            Style="{StaticResource AccentButtonStyle}" />
                                        <Button
                                            x:Name="ReviseCancelButton"
                                            Grid.Column="1"
                                            Click="ReviseCancelButton_Click"
                                            Content="取消"
                                            Visibility="Collapsed" />
                                        <ProgressRing
                                            x:Name="ReviseRing"
                                            Grid.Column="2"
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Left"
                                            IsActive="False"
                                            Visibility="Collapsed" />
                                    </Grid>
                                    <ProgressBar
                                        x:Name="ReviseProgress"
                                        Height="4"
                                        Maximum="100"
                                        CornerRadius="2"
                                        Value="0" />
                                    <TextBlock
                                        x:Name="ReviseStatus"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="提交后会生成新版本，旧版本仍保留在版本走廊里。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border
                    Padding="18"
                    BorderBrush="{ThemeResource ContactableHairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                            <GradientStop Offset="0" Color="#1FA0C4FF" />
                            <GradientStop Offset="1" Color="#0890B4FF" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="4"
                                Height="20"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ContactableAccentBrush}"
                                CornerRadius="2" />
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="最近生成" />
                                <TextBlock
                                    CharacterSpacing="100"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="04 · RECENT" />
                            </StackPanel>
                            <TextBlock
                                x:Name="RecentCount"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <ListView
                            x:Name="RecentList"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="96" Height="54">
                                            <Border Background="{ThemeResource ContactableChipBrush}" CornerRadius="8" />
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Grid>
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="1"
                                                Text="{Binding Prompt}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding CreatedText}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <Button
                                                Click="ReuseRecent_Click"
                                                Content="回填"
                                                Tag="{Binding}" />
                                            <Button
                                                Click="ApplyRecent_Click"
                                                Content="应用"
                                                Tag="{Binding}" />
                                            <Button
                                                Click="DeleteRecent_Click"
                                                Content="删除"
                                                Tag="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel
                            x:Name="RecentEmptyPanel"
                            Spacing="8">
                            <Grid
                                Width="150"
                                Height="96"
                                HorizontalAlignment="Left">
                                <Ellipse
                                    Width="124"
                                    Height="34"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Stroke="#FFF59E0B"
                                    StrokeThickness="2"
                                    Opacity="0.55">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-14" CenterX="62" CenterY="17" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse
                                    Width="58"
                                    Height="58"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Offset="0" Color="#FF0A0F1E" />
                                            <GradientStop Offset="0.72" Color="#FF12203B" />
                                            <GradientStop Offset="1" Color="#FF1B2E4F" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse
                                    Width="72"
                                    Height="72"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Stroke="#666EA8FE"
                                    StrokeThickness="1"
                                    Opacity="0.5" />
                            </Grid>
                            <TextBlock FontWeight="SemiBold" Text="还没有生成记录" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="先在上方选一个风格、写下描述，然后点“开始生成”。生成成功的壁纸会出现在这里，可回填、应用或删除。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Padding="18"
                    BorderBrush="{ThemeResource ContactableHairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                            <GradientStop Offset="0" Color="#1FA0C4FF" />
                            <GradientStop Offset="1" Color="#0890B4FF" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="4"
                                Height="20"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ContactableAccentBrush}"
                                CornerRadius="2" />
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="深度视差（照片转 3D）" />
                                <TextBlock
                                    CharacterSpacing="100"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="05 · DEPTH · LOCAL MIDAS" />
                            </StackPanel>
                            <Button
                                x:Name="PickPhotoButton"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="PickPhotoButton_Click"
                                Content="选择照片" />
                        </Grid>
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="选一张照片，本地 MiDaS 估计深度并生成可交互的视差壁纸。首次使用会下载约 62 MB 模型，之后完全离线。"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="PhotoPathText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="尚未选择照片。"
                            TextTrimming="CharacterEllipsis" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="DepthStatus" Text="选择照片后即可生成。" />
                                <ProgressBar
                                    x:Name="DepthProgress"
                                    Height="6"
                                    Maximum="100"
                                    CornerRadius="3"
                                    Value="0" />
                            </StackPanel>
                            <Button
                                x:Name="DepthGenerateButton"
                                Grid.Column="1"
                                MinWidth="128"
                                VerticalAlignment="Center"
                                Click="DepthGenerateButton_Click"
                                Content="生成视差壁纸"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                x:Name="DepthCancelButton"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="DepthCancelButton_Click"
                                Content="取消"
                                Visibility="Collapsed" />
                            <ProgressRing
                                x:Name="DepthRing"
                                Grid.Column="3"
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                IsActive="False"
                                Visibility="Collapsed" />
                        </Grid>
                    </StackPanel>
                </Border>

                <InfoBar
                    x:Name="StatusBar"
                    IsClosable="True"
                    IsOpen="False" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
