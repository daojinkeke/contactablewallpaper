<Page
    x:Class="Lively.UI.WinUI.Views.Pages.Contactable.WallpaperLibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Lively.UI.WinUI.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <!--  远景：星尘与吸积光晕，纯装饰  -->
        <Grid IsHitTestVisible="False">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#140B1E3F" />
                    <GradientStop Offset="0.5" Color="#00000000" />
                    <GradientStop Offset="1" Color="#14F59E0B" />
                </LinearGradientBrush>
            </Grid.Background>
            <Ellipse
                Width="640"
                Height="380"
                Margin="0,-210,-200,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#3A6EA8FE" />
                        <GradientStop Offset="1" Color="#006EA8FE" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse
                Width="520"
                Height="340"
                Margin="-180,0,0,-170"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#2EF59E0B" />
                        <GradientStop Offset="1" Color="#00F59E0B" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Path
                Fill="#59D6E4FF"
                Stretch="Fill"
                Data="M76,64 A2,2 0 1 1 80,64 A2,2 0 1 1 76,64 Z M206,132 A2,2 0 1 1 210,132 A2,2 0 1 1 206,132 Z M336,56 A2,2 0 1 1 340,56 A2,2 0 1 1 336,56 Z M466,168 A2,2 0 1 1 470,168 A2,2 0 1 1 466,168 Z M596,86 A2,2 0 1 1 600,86 A2,2 0 1 1 596,86 Z M726,146 A2,2 0 1 1 730,146 A2,2 0 1 1 726,146 Z M856,66 A2,2 0 1 1 860,66 A2,2 0 1 1 856,66 Z M956,204 A2,2 0 1 1 960,204 A2,2 0 1 1 956,204 Z M116,292 A2,2 0 1 1 120,292 A2,2 0 1 1 116,292 Z M256,372 A2,2 0 1 1 260,372 A2,2 0 1 1 256,372 Z M396,292 A2,2 0 1 1 400,292 A2,2 0 1 1 396,292 Z M526,412 A2,2 0 1 1 530,412 A2,2 0 1 1 526,412 Z M666,332 A2,2 0 1 1 670,332 A2,2 0 1 1 666,332 Z M806,432 A2,2 0 1 1 810,432 A2,2 0 1 1 806,432 Z M926,352 A2,2 0 1 1 930,352 A2,2 0 1 1 926,352 Z M56,512 A2,2 0 1 1 60,512 A2,2 0 1 1 56,512 Z M186,602 A2,2 0 1 1 190,602 A2,2 0 1 1 186,602 Z M336,532 A2,2 0 1 1 340,532 A2,2 0 1 1 336,532 Z M486,632 A2,2 0 1 1 490,632 A2,2 0 1 1 486,632 Z M626,552 A2,2 0 1 1 630,552 A2,2 0 1 1 626,552 Z M766,642 A2,2 0 1 1 770,642 A2,2 0 1 1 766,642 Z M896,552 A2,2 0 1 1 900,552 A2,2 0 1 1 896,552 Z" />
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Margin="28,18,28,10"
                Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon
                        Width="22"
                        Height="22"
                        Foreground="{ThemeResource ContactableAccentBrush}"
                        Data="F1 M2 12 A10 10 0 1 1 22 12 A10 10 0 1 1 2 12 Z M5.4 12 A6.6 6.6 0 1 0 18.6 12 A6.6 6.6 0 1 0 5.4 12 Z" />
                    <TextBlock
                        VerticalAlignment="Center"
                        CharacterSpacing="120"
                        FontSize="11"
                        Foreground="{ThemeResource ContactableAccentBrush}"
                        Text="SHELL 02 · LIBRARY" />
                </StackPanel>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock FontSize="30" FontWeight="SemiBold" Text="壁纸库" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                x:Name="CountText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="0 张" />
                            <Border
                                Padding="8,0"
                                Background="#1A6EA8FE"
                                CornerRadius="8">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    CharacterSpacing="100"
                                    FontSize="10"
                                    Foreground="{ThemeResource ContactableAccentBrush}"
                                    Text="LOCAL COLLECTION" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <ComboBox
                        x:Name="MonitorCombo"
                        Grid.Column="1"
                        MinWidth="190"
                        VerticalAlignment="Bottom"
                        DisplayMemberPath="Label" />
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button Click="RefreshButton_Click" Content="刷新" />
                        <Button
                            Click="CreateButton_Click"
                            Content="新建壁纸"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>

                <!--  存储位置：一眼看到壁纸实际保存在哪里，并按来源筛选  -->
                <Border
                    Padding="14,12"
                    Background="#146EA8FE"
                    BorderBrush="{ThemeResource ContactableHairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock
                                CharacterSpacing="100"
                                FontSize="10"
                                Foreground="{ThemeResource ContactableAccentBrush}"
                                Text="STORAGE · 壁纸库位置" />
                            <TextBlock
                                x:Name="LibraryPathText"
                                FontSize="13"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="LibrarySourceSummary"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="AI 生成 0 张 · 我导入的 0 张 · 内置 0 张"
                                TextWrapping="Wrap" />
                            <StackPanel
                                Margin="0,4,0,0"
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="按来源查看" />
                                <ComboBox
                                    x:Name="SourceFilterCombo"
                                    MinWidth="180"
                                    DisplayMemberPath="Label"
                                    SelectionChanged="SourceFilterCombo_SelectionChanged" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button Click="OpenFolderButton_Click" Content="打开壁纸库" />
                            <Button Click="OpenDraftsButton_Click" Content="打开生成草稿" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <Grid Grid.Row="1" Margin="28,0,28,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ProgressBar
                    x:Name="LoadingBar"
                    Height="4"
                    Margin="0,0,0,10"
                    CornerRadius="2"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />
                <ProgressBar
                    x:Name="ApplyProgress"
                    Grid.Row="1"
                    Height="4"
                    Margin="0,0,0,10"
                    VerticalAlignment="Bottom"
                    CornerRadius="2"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />

                <GridView
                    x:Name="LibraryGrid"
                    Grid.Row="1"
                    IsItemClickEnabled="False"
                    SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="270"
                                Margin="0,0,12,12"
                                BorderBrush="{ThemeResource ContactableHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                                        <GradientStop Offset="0" Color="#1FA0C4FF" />
                                        <GradientStop Offset="1" Color="#0890B4FF" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel>
                                    <Grid Height="144">
                                        <Border
                                            Background="{ThemeResource ContactableChipBrush}"
                                            CornerRadius="14,14,0,0" />
                                        <Image
                                            Height="144"
                                            Source="{Binding Thumbnail}"
                                            Stretch="UniformToFill" />
                                        <Border
                                            Margin="8"
                                            Padding="8,2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="#CC0B1220"
                                            CornerRadius="8"
                                            Visibility="{Binding IsInUse, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="#D6E4FF"
                                                Text="使用中" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Padding="12" Spacing="4">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding TypeText}" />
                                            <Border
                                                Padding="6,1"
                                                VerticalAlignment="Center"
                                                Background="#1A6EA8FE"
                                                CornerRadius="6">
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="{ThemeResource ContactableAccentBrush}"
                                                    Text="{Binding SourceText}" />
                                            </Border>
                                        </StackPanel>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{Binding FolderNameText}"
                                                TextTrimming="CharacterEllipsis" />
                                            <HyperlinkButton
                                                Grid.Column="1"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Click="LocateItem_Click"
                                                Content="定位"
                                                FontSize="11"
                                                Tag="{Binding}" />
                                        </Grid>
                                        <StackPanel
                                            Margin="0,6,0,0"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <Button
                                                Click="ApplyItem_Click"
                                                Content="应用"
                                                Tag="{Binding}" />
                                            <Button
                                                Click="PreviewItem_Click"
                                                Content="预览"
                                                Tag="{Binding}" />
                                            <Button
                                                Click="DeleteItem_Click"
                                                Content="删除"
                                                Tag="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <StackPanel
                    x:Name="EmptyPanel"
                    Grid.Row="1"
                    MaxWidth="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="Collapsed">
                    <Grid
                        Width="190"
                        Height="124"
                        HorizontalAlignment="Center">
                        <Ellipse
                            Width="164"
                            Height="44"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stroke="#FFF59E0B"
                            StrokeThickness="2"
                            Opacity="0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-14" CenterX="82" CenterY="22" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse
                            Width="96"
                            Height="56"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stroke="#667EA8FF"
                            StrokeThickness="1"
                            Opacity="0.35">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="16" CenterX="48" CenterY="28" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse
                            Width="70"
                            Height="70"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0" Color="#FF080D1A" />
                                    <GradientStop Offset="0.7" Color="#FF12203B" />
                                    <GradientStop Offset="1" Color="#FF1E3457" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse
                            Width="84"
                            Height="84"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stroke="#596EA8FE"
                            StrokeThickness="1" />
                    </Grid>
                    <TextBlock
                        x:Name="EmptyTitle"
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="壁纸库还是空的" />
                    <TextBlock
                        x:Name="EmptyDetail"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="去“新建壁纸”生成第一张，或点击刷新重新扫描。"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="EmptyCreateButton"
                            Click="CreateButton_Click"
                            Content="去新建壁纸"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            Click="RefreshButton_Click"
                            Content="刷新" />
                    </StackPanel>
                </StackPanel>

                <ProgressRing
                    x:Name="LoadingRing"
                    Grid.Row="1"
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />
            </Grid>

            <InfoBar
                x:Name="StatusBar"
                Grid.Row="2"
                Margin="28,8,28,16"
                IsClosable="True"
                IsOpen="False" />
        </Grid>
    </Grid>
</Page>
