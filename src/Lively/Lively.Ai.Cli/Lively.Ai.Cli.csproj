<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 与控制台 CLI 实际依赖一致：只用托管 API，不需要 Windows SDK 投影 -->
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>LatestMajor</RollForward>
    <AssemblyName>Lively.Ai.Cli</AssemblyName>
    <RootNamespace>Lively.Ai.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lively.Ai\Lively.Ai.csproj" />
  </ItemGroup>

</Project>
